# Neon connection string (Dashboard → Connect). The pooled host (…-pooler…) is fine for the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Optional: the direct (unpooled) host, used for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

PORT=3000
# Comma-separated origins allowed to call the API (the Angular dev servers).
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
