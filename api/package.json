{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "typeorm": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "typeorm migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@rspack/core": "^2.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "@garden/shared": "file:../shared",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "typeorm": "^1.1.3",
    "zod": "^4.6.6"
  }
}
